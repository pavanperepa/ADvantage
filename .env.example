# Copy this file to .env and insert your keys. Never commit .env.
OPENAI_API_KEY=
IDEOGRAM_API_KEY=

# Short-lived read-only OAuth token for local Google Drive intake preflight.
# Production connections must store per-user refresh tokens server-side.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Explicitly requested model. Override only if you intend to change it.
OPENAI_MODEL=gpt-5.4

# Read-only Meta Ads export configuration.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=614367564654088
META_API_VERSION=v24.0
