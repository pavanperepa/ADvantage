# Copy this file to .env and insert your keys. Never commit .env.
OPENAI_API_KEY=
IDEOGRAM_API_KEY=
SLACK_BOT_TOKEN=

# Read-only Google Drive OAuth for local intake. Register this exact callback on
# the Google Cloud OAuth web client, then run google_drive_authorize.py once.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://localhost:8765/oauth2/callback
GOOGLE_DRIVE_REFRESH_TOKEN=

# Added automatically when a public Vercel Blob store is connected. It may be
# set locally for deployment-storage integration tests; never expose it to the
# browser or commit a real value.
BLOB_READ_WRITE_TOKEN=

# Optional short-lived fallback for manual preflight. When a refresh token is
# configured, the intake command renews access automatically and ignores this.
GOOGLE_DRIVE_ACCESS_TOKEN=

# Explicitly requested model. Override only if you intend to change it.
OPENAI_MODEL=gpt-5.4

# Read-only Meta Ads export configuration.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=614367564654088
META_API_VERSION=v24.0
